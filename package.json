{
  "name": "atlas-eye",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test:positioning": "node scripts/validate-positioning.mjs",
    "test:contact": "node --test tests/contact-form.test.mjs",
    "test:part53": "node --test tests/part53-integration.test.mjs",
    "test:part53:adversarial": "node tests/part53-adversarial-runner.mjs --profile standard",
    "test:part53:smoke": "node tests/part53-adversarial-runner.mjs --profile smoke",
    "test:part53:soak": "node tests/part53-adversarial-runner.mjs --profile soak",
    "test:part53:production-smoke": "node tests/part53-adversarial-runner.mjs --profile production-smoke",
    "test:part53:replay": "node tests/part53-adversarial-runner.mjs --profile replay",
